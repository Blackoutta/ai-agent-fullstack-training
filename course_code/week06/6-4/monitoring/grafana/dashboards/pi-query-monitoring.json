{
  "uid": "pi-query-monitoring",
  "title": "订单查询 Agent 监控",
  "tags": ["pi", "agent", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "editable": true,
  "panels": [
    {
      "type": "row",
      "title": "业务层 · 用户的事办成了吗",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "任务成功率",
      "description": "成功任务增量 ÷ 已结束任务增量",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(order_query_success_total{job=\"order-backend\"}[5m])) / sum(increase(order_query_completed_total{job=\"order-backend\"}[5m]))",
          "legendFormat": "任务成功率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "人工接管率",
      "description": "人工接管任务增量 ÷ 已结束任务增量",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(order_query_handoff_total{job=\"order-backend\"}[5m])) / sum(increase(order_query_completed_total{job=\"order-backend\"}[5m]))",
          "legendFormat": "人工接管率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "业务层趋势",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(order_query_success_total{job=\"order-backend\"}[5m])) / sum(increase(order_query_completed_total{job=\"order-backend\"}[5m]))",
          "legendFormat": "任务成功率"
        },
        {
          "refId": "B",
          "expr": "sum(increase(order_query_handoff_total{job=\"order-backend\"}[5m])) / sum(increase(order_query_completed_total{job=\"order-backend\"}[5m]))",
          "legendFormat": "人工接管率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Agent 层 · 工具选对了吗、执行失败吗、检索命中吗",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "工具调用准确率",
      "description": "选对的工具调用数 ÷ 已核对的工具调用数",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(agent_tool_calls_correct_total{job=\"order-backend\"}[5m])) / sum(increase(agent_tool_calls_checked_total{job=\"order-backend\"}[5m]))",
          "legendFormat": "工具调用准确率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "工具失败率",
      "description": "执行失败数 ÷ 已结束的工具调用数",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(agent_tool_calls_failed_total{job=\"order-backend\"}[5m])) / sum(increase(agent_tool_calls_finished_total{job=\"order-backend\"}[5m]))",
          "legendFormat": "工具失败率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 0.3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "检索命中率 Hit@3",
      "description": "前三条命中目标规则的检索数 ÷ 已核对的成功检索数",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(agent_retrieval_hits_total{job=\"order-backend\"}[5m])) / sum(increase(agent_retrieval_checked_total{job=\"order-backend\"}[5m]))",
          "legendFormat": "检索命中率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Agent 层趋势",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(agent_tool_calls_correct_total{job=\"order-backend\"}[5m])) / sum(increase(agent_tool_calls_checked_total{job=\"order-backend\"}[5m]))",
          "legendFormat": "准确率"
        },
        {
          "refId": "B",
          "expr": "sum(increase(agent_tool_calls_failed_total{job=\"order-backend\"}[5m])) / sum(increase(agent_tool_calls_finished_total{job=\"order-backend\"}[5m]))",
          "legendFormat": "失败率"
        },
        {
          "refId": "C",
          "expr": "sum(increase(agent_retrieval_hits_total{job=\"order-backend\"}[5m])) / sum(increase(agent_retrieval_checked_total{job=\"order-backend\"}[5m]))",
          "legendFormat": "命中率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "模型层 · 一次调用要等多久、多少以错误结束",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "模型平均延迟",
      "description": "Histogram 的 _sum 增量 ÷ _count 增量",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(agent_model_call_duration_seconds_sum{job=\"order-backend\"}[5m])) / sum(increase(agent_model_call_duration_seconds_count{job=\"order-backend\"}[5m]))",
          "legendFormat": "平均延迟"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "模型调用失败率",
      "description": "error 调用增量 ÷ (success + error) 调用增量",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(agent_model_calls_total{job=\"order-backend\",outcome=\"error\"}[5m])) / (sum(increase(agent_model_calls_total{job=\"order-backend\",outcome=\"success\"}[5m])) + sum(increase(agent_model_calls_total{job=\"order-backend\",outcome=\"error\"}[5m])))",
          "legendFormat": "模型调用失败率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 0.3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "模型延迟趋势（平均 / P95）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(agent_model_call_duration_seconds_sum{job=\"order-backend\"}[5m])) / sum(increase(agent_model_call_duration_seconds_count{job=\"order-backend\"}[5m]))",
          "legendFormat": "平均延迟"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_model_call_duration_seconds_bucket{job=\"order-backend\"}[5m])))",
          "legendFormat": "P95 延迟"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
