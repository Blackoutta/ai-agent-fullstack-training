{
  "name": "pi-query-monitoring-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "demo": "node --env-file-if-exists=.env pi-monitor-demo.mts",
    "demo:serve": "node --env-file-if-exists=.env pi-monitor-demo.mts --serve",
    "prom:up": "docker compose -f monitoring/docker-compose.yml up -d",
    "prom:down": "docker compose -f monitoring/docker-compose.yml down",
    "prom:status": "docker compose -f monitoring/docker-compose.yml ps",
    "prom:query": "node monitoring/query-metrics.mts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "prom-client": "^15.1.3",
    "typebox": "1.3.27"
  }
}
